{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/voice-enabled\" ] && uv run --directory \"${CLAUDE_PLUGIN_ROOT}/python\" python \"${CLAUDE_PLUGIN_ROOT}/scripts/say-response.py\" || true",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/voice-enabled\" ] && uv run --directory \"${CLAUDE_PLUGIN_ROOT}/python\" python \"${CLAUDE_PLUGIN_ROOT}/scripts/say-response.py\" || true",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/voice-enabled\" ] && uv run --directory \"${CLAUDE_PLUGIN_ROOT}/python\" python \"${CLAUDE_PLUGIN_ROOT}/scripts/say-response.py\" || true",
            "async": true
          }
        ]
      }
    ]
  }
}
